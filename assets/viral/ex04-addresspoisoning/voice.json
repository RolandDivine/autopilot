[{"start": 0.0, "end": 1.14, "text": "Hey, Kobo here.", "words": [[0.0, 0.3, " Hey,"], [0.72, 0.82, " Kobo"], [0.82, 1.14, " here."]]}, {"start": 1.74, "end": 4.92, "text": "Here's a crypto scam that doesn't need you to click anything.", "words": [[1.74, 1.94, " Here's"], [1.94, 2.12, " a"], [2.12, 2.34, " crypto"], [2.34, 2.68, " scam"], [2.68, 3.04, " that"], [3.04, 3.44, " doesn't"], [3.44, 3.68, " need"], [3.68, 3.86, " you"], [3.86, 4.0, " to"], [4.0, 4.26, " click"], [4.26, 4.92, " anything."]]}, {"start": 5.94, "end": 7.44, "text": "Crypto addresses are long,", "words": [[5.94, 6.06, " Crypto"], [6.06, 6.52, " addresses"], [6.52, 7.0, " are"], [7.0, 7.44, " long,"]]}, {"start": 7.8, "end": 10.24, "text": "so most people only check the first few", "words": [[7.8, 8.06, " so"], [8.06, 8.3, " most"], [8.3, 8.64, " people"], [8.64, 9.06, " only"], [9.06, 9.38, " check"], [9.38, 9.58, " the"], [9.58, 9.92, " first"], [9.92, 10.24, " few"]]}, {"start": 10.24, "end": 11.98, "text": "and the last few characters.", "words": [[10.24, 10.7, " and"], [10.7, 10.86, " the"], [10.86, 11.18, " last"], [11.18, 11.48, " few"], [11.48, 11.98, " characters."]]}, {"start": 13.02, "end": 14.12, "text": "Scammers know this.", "words": [[13.02, 13.2, " Scammers"], [13.2, 13.74, " know"], [13.74, 14.12, " this."]]}, {"start": 14.62, "end": 16.46, "text": "They create an address that starts", "words": [[14.62, 14.86, " They"], [14.86, 15.18, " create"], [15.18, 15.36, " an"], [15.36, 15.78, " address"], [15.78, 16.04, " that"], [16.04, 16.46, " starts"]]}, {"start": 16.46, "end": 19.74, "text": "and ends exactly like one you've used before.", "words": [[16.46, 16.82, " and"], [16.82, 17.34, " ends"], [17.34, 18.0, " exactly"], [18.0, 18.42, " like"], [18.42, 18.72, " one"], [18.72, 19.04, " you've"], [19.04, 19.26, " used"], [19.26, 19.74, " before."]]}, {"start": 20.36, "end": 22.66, "text": "Then they send you a tiny transaction,", "words": [[20.36, 20.62, " Then"], [20.62, 20.84, " they"], [20.84, 21.08, " send"], [21.08, 21.28, " you"], [21.28, 21.5, " a"], [21.5, 21.92, " tiny"], [21.92, 22.66, " transaction,"]]}, {"start": 23.2, "end": 26.62, "text": "sometimes zero, from that look-alike address.", "words": [[23.2, 23.66, " sometimes"], [23.66, 24.38, " zero,"], [24.76, 25.08, " from"], [25.08, 25.44, " that"], [25.44, 25.82, " look"], [25.82, 26.1, "-alike"], [26.1, 26.62, " address."]]}, {"start": 27.36, "end": 29.3, "text": "Now it sits in your history.", "words": [[27.36, 27.68, " Now"], [27.68, 28.04, " it"], [28.04, 28.34, " sits"], [28.34, 28.68, " in"], [28.68, 28.82, " your"], [28.82, 29.3, " history."]]}, {"start": 30.02, "end": 31.5, "text": "Next time you want to send money,", "words": [[29.85, 30.22, " Next"], [30.22, 30.52, " time"], [30.52, 30.7, " you"], [30.7, 30.84, " want"], [30.84, 30.94, " to"], [30.94, 31.12, " send"], [31.12, 31.5, " money,"]]}, {"start": 31.98, "end": 33.98, "text": "you copy an address from your history.", "words": [[31.98, 32.04, " you"], [32.04, 32.38, " copy"], [32.38, 32.6, " an"], [32.6, 33.06, " address"], [33.06, 33.34, " from"], [33.34, 33.52, " your"], [33.52, 33.98, " history."]]}, {"start": 34.36, "end": 36.76, "text": "You check the start, you check the end.", "words": [[34.36, 34.62, " You"], [34.62, 34.86, " check"], [34.86, 35.06, " the"], [35.06, 35.4, " start,"], [35.82, 35.9, " you"], [35.9, 36.18, " check"], [36.18, 36.38, " the"], [36.38, 36.76, " end."]]}, {"start": 37.28, "end": 41.16, "text": "Looks right, but you just copied the scammer's address", "words": [[37.28, 37.42, " Looks"], [37.42, 37.78, " right,"], [38.24, 38.58, " but"], [38.58, 38.78, " you"], [38.78, 39.18, " just"], [39.18, 39.72, " copied"], [39.72, 39.96, " the"], [39.96, 40.7, " scammer's"], [40.7, 41.16, " address"]]}, {"start": 41.78, "end": 44.46, "text": "and crypto transfers can't be reversed.", "words": [[41.59, 41.96, " and"], [41.96, 42.38, " crypto"], [42.38, 42.94, " transfers"], [42.94, 43.74, " can't"], [43.74, 43.92, " be"], [43.92, 44.46, " reversed."]]}, {"start": 45.52, "end": 46.18, "text": "Kobo's rules.", "words": [[45.52, 45.86, " Kobo's"], [45.86, 46.18, " rules."]]}, {"start": 47.06, "end": 50.1, "text": "Never copy addresses from your transaction history.", "words": [[47.06, 47.32, " Never"], [47.32, 47.82, " copy"], [47.82, 48.42, " addresses"], [48.42, 48.78, " from"], [48.78, 48.96, " your"], [48.96, 49.5, " transaction"], [49.5, 50.1, " history."]]}, {"start": 50.76, "end": 54.04, "text": "Save trusted addresses in your wallet's address book.", "words": [[50.76, 51.06, " Save"], [51.06, 51.58, " trusted"], [51.58, 52.16, " addresses"], [52.16, 52.56, " in"], [52.56, 52.76, " your"], [52.76, 53.3, " wallet's"], [53.3, 53.68, " address"], [53.68, 54.04, " book."]]}, {"start": 54.64, "end": 57.64, "text": "For big amounts, send a small test first", "words": [[54.64, 54.88, " For"], [54.88, 55.14, " big"], [55.14, 55.6, " amounts,"], [55.92, 56.18, " send"], [56.18, 56.36, " a"], [56.36, 56.74, " small"], [56.74, 57.16, " test"], [57.16, 57.64, " first"]]}, {"start": 57.64, "end": 59.42, "text": "and confirm it arrived.", "words": [[57.64, 58.2, " and"], [58.2, 58.7, " confirm"], [58.7, 58.9, " it"], [58.9, 59.42, " arrived."]]}, {"start": 60.08, "end": 63.72, "text": "And check the whole address, not just the ends.", "words": [[60.08, 60.3, " And"], [60.3, 60.58, " check"], [60.58, 60.82, " the"], [60.82, 61.24, " whole"], [61.24, 61.88, " address,"], [62.34, 62.68, " not"], [62.68, 63.04, " just"], [63.04, 63.3, " the"], [63.3, 63.72, " ends."]]}, {"start": 64.42, "end": 67.18, "text": "10 extra seconds can save everything.", "words": [[64.42, 64.64, " 10"], [64.64, 65.1, " extra"], [65.1, 65.56, " seconds"], [65.56, 65.92, " can"], [65.92, 66.36, " save"], [66.36, 67.18, " everything."]]}, {"start": 67.84, "end": 68.22, "text": "See ya.", "words": [[67.84, 68.06, " See"], [68.06, 68.22, " ya."]]}]