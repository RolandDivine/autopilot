[{"start": 0.0, "end": 2.4, "text": "Hey, Kobo here, your phone rings.", "words": [[0.0, 0.28, " Hey,"], [0.76, 0.84, " Kobo"], [0.84, 1.18, " here,"], [1.6, 1.76, " your"], [1.76, 2.02, " phone"], [2.02, 2.4, " rings."]]}, {"start": 2.9, "end": 3.76, "text": "It's your brother's voice.", "words": [[2.9, 2.98, " It's"], [2.98, 3.1, " your"], [3.1, 3.52, " brother's"], [3.52, 3.76, " voice."]]}, {"start": 4.28, "end": 4.84, "text": "He's crying.", "words": [[4.28, 4.44, " He's"], [4.44, 4.84, " crying."]]}, {"start": 5.3, "end": 7.6, "text": "He's in trouble and needs money right now.", "words": [[5.3, 5.52, " He's"], [5.52, 5.64, " in"], [5.64, 5.9, " trouble"], [5.9, 6.22, " and"], [6.22, 6.44, " needs"], [6.44, 6.78, " money"], [6.78, 7.14, " right"], [7.14, 7.6, " now."]]}, {"start": 8.08, "end": 8.82, "text": "Don't tell mom.", "words": [[8.08, 8.34, " Don't"], [8.34, 8.56, " tell"], [8.56, 8.82, " mom."]]}, {"start": 9.52, "end": 11.1, "text": "Except it isn't him.", "words": [[9.52, 9.84, " Except"], [9.84, 10.38, " it"], [10.38, 10.74, " isn't"], [10.74, 11.1, " him."]]}, {"start": 11.82, "end": 14.82, "text": "AI can now copy a voice from a few seconds of audio.", "words": [[11.82, 11.82, " AI"], [11.82, 12.12, " can"], [12.12, 12.38, " now"], [12.38, 12.7, " copy"], [12.7, 12.88, " a"], [12.88, 13.14, " voice"], [13.14, 13.46, " from"], [13.46, 13.6, " a"], [13.6, 13.84, " few"], [13.84, 14.2, " seconds"], [14.2, 14.4, " of"], [14.4, 14.82, " audio."]]}, {"start": 15.38, "end": 17.54, "text": "A video on social media is enough.", "words": [[15.38, 15.5, " A"], [15.5, 15.78, " video"], [15.78, 16.08, " on"], [16.08, 16.38, " social"], [16.38, 16.76, " media"], [16.76, 17.12, " is"], [17.12, 17.54, " enough."]]}, {"start": 18.5, "end": 20.84, "text": "Scammers use it to call families and businesses,", "words": [[18.5, 18.68, " Scammers"], [18.68, 18.94, " use"], [18.94, 19.1, " it"], [19.1, 19.26, " to"], [19.26, 19.48, " call"], [19.48, 19.98, " families"], [19.98, 20.32, " and"], [20.32, 20.84, " businesses,"]]}, {"start": 21.3, "end": 22.98, "text": "pretending to be someone you trust.", "words": [[21.3, 21.66, " pretending"], [21.66, 21.92, " to"], [21.92, 22.08, " be"], [22.08, 22.4, " someone"], [22.4, 22.6, " you"], [22.6, 22.98, " trust."]]}, {"start": 23.68, "end": 25.9, "text": "The script always has the same parts.", "words": [[23.68, 23.8, " The"], [23.8, 24.1, " script"], [24.1, 24.64, " always"], [24.64, 24.94, " has"], [24.94, 25.18, " the"], [25.18, 25.44, " same"], [25.44, 25.9, " parts."]]}, {"start": 25.9, "end": 29.76, "text": "Urgency, secrecy, a strange way to pay,", "words": [[25.9, 26.96, " Urgency,"], [27.76, 27.8, " secrecy,"], [28.46, 28.54, " a"], [28.54, 28.96, " strange"], [28.96, 29.26, " way"], [29.26, 29.42, " to"], [29.42, 29.76, " pay,"]]}, {"start": 30.12, "end": 33.0, "text": "like crypto, gift cards, or a new account.", "words": [[30.12, 30.18, " like"], [30.18, 30.76, " crypto,"], [31.12, 31.36, " gift"], [31.36, 31.78, " cards,"], [32.08, 32.24, " or"], [32.24, 32.36, " a"], [32.36, 32.5, " new"], [32.5, 33.0, " account."]]}, {"start": 33.64, "end": 34.56, "text": "How to beat it.", "words": [[33.64, 33.78, " How"], [33.78, 33.96, " to"], [33.96, 34.16, " beat"], [34.16, 34.56, " it."]]}, {"start": 34.88, "end": 38.14, "text": "Agree on a family code word that only you know.", "words": [[34.88, 35.24, " Agree"], [35.24, 35.48, " on"], [35.48, 35.64, " a"], [35.64, 35.98, " family"], [35.98, 36.32, " code"], [36.32, 36.66, " word"], [36.66, 36.98, " that"], [36.98, 37.34, " only"], [37.34, 37.8, " you"], [37.8, 38.14, " know."]]}, {"start": 38.7, "end": 42.46, "text": "If a call feels off, hang up and call the person back", "words": [[38.7, 38.82, " If"], [38.82, 38.96, " a"], [38.96, 39.2, " call"], [39.2, 39.56, " feels"], [39.56, 39.98, " off,"], [40.48, 40.72, " hang"], [40.72, 40.96, " up"], [40.96, 41.4, " and"], [41.4, 41.68, " call"], [41.68, 41.84, " the"], [41.84, 42.12, " person"], [42.12, 42.46, " back"]]}, {"start": 42.46, "end": 44.34, "text": "on the number you already have.", "words": [[42.46, 42.7, " on"], [42.7, 42.86, " the"], [42.86, 43.06, " number"], [43.06, 43.32, " you"], [43.32, 43.8, " already"], [43.8, 44.34, " have."]]}, {"start": 44.8, "end": 48.02, "text": "Ask a question only the real person could answer.", "words": [[44.8, 45.12, " Ask"], [45.12, 45.34, " a"], [45.34, 45.72, " question"], [45.72, 46.22, " only"], [46.22, 46.56, " the"], [46.56, 46.84, " real"], [46.84, 47.3, " person"], [47.3, 47.54, " could"], [47.54, 48.02, " answer."]]}, {"start": 48.62, "end": 52.24, "text": "And remember, a familiar voice is no longer proof", "words": [[48.62, 48.78, " And"], [48.78, 49.18, " remember,"], [49.66, 49.84, " a"], [49.84, 50.22, " familiar"], [50.22, 50.72, " voice"], [50.72, 51.06, " is"], [51.06, 51.44, " no"], [51.44, 51.84, " longer"], [51.84, 52.24, " proof"]]}, {"start": 52.24, "end": 53.4, "text": "of who's speaking.", "words": [[52.24, 52.6, " of"], [52.6, 52.98, " who's"], [52.98, 53.4, " speaking."]]}, {"start": 54.08, "end": 57.22, "text": "Slow down, verify, then act.", "words": [[54.08, 54.46, " Slow"], [54.46, 54.92, " down,"], [55.44, 55.72, " verify,"], [56.58, 56.72, " then"], [56.72, 57.22, " act."]]}, {"start": 58.06, "end": 59.02, "text": "Share this with your family.", "words": [[58.06, 58.14, " Share"], [58.14, 58.36, " this"], [58.36, 58.58, " with"], [58.58, 58.74, " your"], [58.74, 59.02, " family."]]}, {"start": 59.62, "end": 59.98, "text": "See ya.", "words": [[59.62, 59.8, " See"], [59.8, 59.98, " ya."]]}]