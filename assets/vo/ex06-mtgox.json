[{"start": 0.0, "end": 1.18, "text": "Hey, Kobo here.", "words": [[0.0, 0.28, " Hey,"], [0.72, 0.8, " Kobo"], [0.8, 1.18, " here."]]}, {"start": 2.04, "end": 4.32, "text": "Before FTX, there was Mt. Gox.", "words": [[2.04, 2.14, " Before"], [2.14, 2.88, " FTX,"], [3.32, 3.34, " there"], [3.34, 3.54, " was"], [3.54, 3.9, " Mt."], [4.22, 4.32, " Gox."]]}, {"start": 5.1, "end": 8.54, "text": "In the early 2010s, Mt. Gox, based in Tokyo,", "words": [[5.1, 5.28, " In"], [5.28, 5.38, " the"], [5.38, 5.7, " early"], [5.7, 6.72, " 2010s,"], [6.92, 7.04, " Mt."], [7.34, 7.54, " Gox,"], [7.66, 7.96, " based"], [7.96, 8.2, " in"], [8.2, 8.54, " Tokyo,"]]}, {"start": 8.94, "end": 12.02, "text": "was the biggest Bitcoin exchange in the world.", "words": [[8.94, 9.16, " was"], [9.16, 9.4, " the"], [9.4, 9.8, " biggest"], [9.8, 10.42, " Bitcoin"], [10.42, 10.88, " exchange"], [10.88, 11.4, " in"], [11.4, 11.6, " the"], [11.6, 12.02, " world."]]}, {"start": 12.7, "end": 16.54, "text": "At its peak, it handled most of all Bitcoin trades.", "words": [[12.7, 12.98, " At"], [12.98, 13.16, " its"], [13.16, 13.5, " peak,"], [13.7, 13.94, " it"], [13.94, 14.26, " handled"], [14.26, 14.72, " most"], [14.72, 15.06, " of"], [15.06, 15.46, " all"], [15.46, 16.02, " Bitcoin"], [16.02, 16.54, " trades."]]}, {"start": 17.24, "end": 20.34, "text": "In February 2014, it stopped withdrawals", "words": [[17.24, 17.4, " In"], [17.4, 17.74, " February"], [17.74, 18.76, " 2014,"], [19.02, 19.34, " it"], [19.34, 19.74, " stopped"], [19.74, 20.34, " withdrawals"]]}, {"start": 20.34, "end": 22.66, "text": "and then filed for bankruptcy.", "words": [[20.34, 20.96, " and"], [20.96, 21.34, " then"], [21.34, 21.86, " filed"], [21.86, 22.18, " for"], [22.18, 22.66, " bankruptcy."]]}, {"start": 23.28, "end": 26.6, "text": "About 850,000 Bitcoin were missing,", "words": [[23.28, 23.48, " About"], [23.48, 24.26, " 850"], [24.26, 25.36, ",000"], [25.36, 25.88, " Bitcoin"], [25.88, 26.14, " were"], [26.14, 26.6, " missing,"]]}, {"start": 26.6, "end": 29.5, "text": "lost to hacks that had gone on for years.", "words": [[26.6, 27.38, " lost"], [27.38, 27.62, " to"], [27.62, 27.94, " hacks"], [27.94, 28.18, " that"], [28.18, 28.32, " had"], [28.32, 28.54, " gone"], [28.54, 28.76, " on"], [28.76, 29.02, " for"], [29.02, 29.5, " years."]]}, {"start": 30.46, "end": 33.26, "text": "Some were found later, but most were gone.", "words": [[30.46, 30.5, " Some"], [30.5, 30.7, " were"], [30.7, 30.98, " found"], [30.98, 31.38, " later,"], [31.72, 31.86, " but"], [31.86, 32.24, " most"], [32.24, 32.76, " were"], [32.76, 33.26, " gone."]]}, {"start": 34.48, "end": 35.82, "text": "Customers waited a decade.", "words": [[34.48, 34.48, " Customers"], [34.48, 34.88, " waited"], [34.88, 35.3, " a"], [35.3, 35.82, " decade."]]}, {"start": 36.56, "end": 39.28, "text": "Repayments only started in 2024.", "words": [[36.56, 37.1, " Repayments"], [37.1, 37.48, " only"], [37.48, 37.96, " started"], [37.96, 38.44, " in"], [38.44, 39.28, " 2024."]]}, {"start": 40.34, "end": 41.18, "text": "What went wrong?", "words": [[40.34, 40.54, " What"], [40.54, 40.78, " went"], [40.78, 41.18, " wrong?"]]}, {"start": 42.48, "end": 44.28, "text": "Customers didn't hold their own keys.", "words": [[42.48, 42.48, " Customers"], [42.48, 43.02, " didn't"], [43.02, 43.28, " hold"], [43.28, 43.5, " their"], [43.5, 43.84, " own"], [43.84, 44.28, " keys."]]}, {"start": 44.84, "end": 46.3, "text": "The exchange did.", "words": [[44.84, 45.06, " The"], [45.06, 45.6, " exchange"], [45.6, 46.3, " did."]]}, {"start": 46.78, "end": 49.86, "text": "And nobody could check if the coins were really there.", "words": [[46.78, 46.98, " And"], [46.98, 47.3, " nobody"], [47.3, 47.62, " could"], [47.62, 47.92, " check"], [47.92, 48.16, " if"], [48.16, 48.34, " the"], [48.34, 48.7, " coins"], [48.7, 48.98, " were"], [48.98, 49.42, " really"], [49.42, 49.86, " there."]]}, {"start": 50.44, "end": 52.3, "text": "The lesson hasn't changed.", "words": [[50.44, 50.7, " The"], [50.7, 51.12, " lesson"], [51.12, 51.8, " hasn't"], [51.8, 52.3, " changed."]]}, {"start": 52.96, "end": 55.62, "text": "An exchange is a place to buy and sell,", "words": [[52.96, 53.04, " An"], [53.04, 53.52, " exchange"], [53.52, 53.86, " is"], [53.86, 54.04, " a"], [54.04, 54.24, " place"], [54.24, 54.52, " to"], [54.52, 54.88, " buy"], [54.88, 55.22, " and"], [55.22, 55.62, " sell,"]]}, {"start": 55.62, "end": 56.98, "text": "not a vault.", "words": [[55.62, 56.36, " not"], [56.36, 56.66, " a"], [56.66, 56.98, " vault."]]}, {"start": 57.66, "end": 59.48, "text": "If you hold for the long-term,", "words": [[57.66, 57.84, " If"], [57.84, 57.98, " you"], [57.98, 58.3, " hold"], [58.3, 58.54, " for"], [58.54, 58.68, " the"], [58.68, 58.96, " long"], [58.96, 59.48, "-term,"]]}, {"start": 59.72, "end": 63.62, "text": "learn self-custody and keep your seed phrase safe.", "words": [[59.72, 60.14, " learn"], [60.14, 60.52, " self"], [60.52, 61.1, "-custody"], [61.1, 61.68, " and"], [61.68, 61.98, " keep"], [61.98, 62.22, " your"], [62.22, 62.6, " seed"], [62.6, 63.1, " phrase"], [63.1, 63.62, " safe."]]}, {"start": 64.62, "end": 66.78, "text": "Not your keys, not your coins.", "words": [[64.62, 64.68, " Not"], [64.68, 64.9, " your"], [64.9, 65.3, " keys,"], [65.98, 66.08, " not"], [66.08, 66.36, " your"], [66.36, 66.78, " coins."]]}, {"start": 67.5, "end": 67.9, "text": "See ya.", "words": [[67.5, 67.72, " See"], [67.72, 67.9, " ya."]]}]