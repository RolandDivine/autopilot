[{"start": 0.0, "end": 6.28, "text": "Hey, Kobo here. Your money can shrink without you spending a single naira, dollar, or pound.", "words": [[0.0, 0.28, " Hey,"], [0.7, 0.78, " Kobo"], [0.78, 1.1, " here."], [1.76, 1.76, " Your"], [1.76, 2.02, " money"], [2.02, 2.28, " can"], [2.28, 2.7, " shrink"], [2.7, 3.12, " without"], [3.12, 3.32, " you"], [3.32, 3.6, " spending"], [3.6, 3.92, " a"], [3.92, 4.4, " single"], [4.4, 5.04, " naira,"], [5.14, 5.46, " dollar,"], [5.86, 5.98, " or"], [5.98, 6.28, " pound."]]}, {"start": 7.06, "end": 13.84, "text": "That's inflation. Inflation means prices rise over time. If inflation is 10% this year,", "words": [[7.06, 7.4, " That's"], [7.4, 7.78, " inflation."], [8.76, 9.08, " Inflation"], [9.08, 9.42, " means"], [9.42, 9.92, " prices"], [9.92, 10.42, " rise"], [10.42, 10.78, " over"], [10.78, 11.14, " time."], [11.82, 11.9, " If"], [11.9, 12.3, " inflation"], [12.3, 12.64, " is"], [12.64, 12.96, " 10"], [12.96, 13.26, "%"], [13.26, 13.56, " this"], [13.56, 13.84, " year,"]]}, {"start": 14.32, "end": 21.66, "text": "something that cost 1,000 now costs 1,100. The money in your drawer is the same, but it buys", "words": [[14.32, 14.48, " something"], [14.48, 14.76, " that"], [14.76, 15.04, " cost"], [15.04, 15.52, " 1"], [15.52, 16.08, ",000"], [16.08, 16.58, " now"], [16.58, 17.12, " costs"], [17.12, 17.44, " 1"], [17.44, 17.82, ",100."], [18.62, 18.82, " The"], [18.82, 19.06, " money"], [19.06, 19.3, " in"], [19.3, 19.46, " your"], [19.46, 19.8, " drawer"], [19.8, 20.1, " is"], [20.1, 20.28, " the"], [20.28, 20.66, " same,"], [20.92, 21.2, " but"], [21.2, 21.34, " it"], [21.34, 21.66, " buys"]]}, {"start": 21.66, "end": 28.6, "text": "less. Why does it happen? Often because there's more money chasing the same goods, or because", "words": [[21.66, 22.08, " less."], [22.84, 23.08, " Why"], [23.08, 23.22, " does"], [23.22, 23.36, " it"], [23.36, 23.66, " happen?"], [24.38, 24.64, " Often"], [24.64, 25.02, " because"], [25.02, 25.32, " there's"], [25.32, 25.62, " more"], [25.62, 25.94, " money"], [25.94, 26.34, " chasing"], [26.34, 26.64, " the"], [26.64, 27.0, " same"], [27.0, 27.42, " goods,"], [27.64, 28.12, " or"], [28.12, 28.6, " because"]]}, {"start": 28.6, "end": 36.76, "text": "things cost more to make and move. Fuel, food, and exchange rates all play a part. What can you do?", "words": [[28.6, 28.9, " things"], [28.9, 29.28, " cost"], [29.28, 29.74, " more"], [29.74, 29.98, " to"], [29.98, 30.28, " make"], [30.28, 30.6, " and"], [30.6, 31.02, " move."], [32.08, 32.08, " Fuel,"], [32.54, 32.8, " food,"], [33.16, 33.26, " and"], [33.26, 33.72, " exchange"], [33.72, 34.14, " rates"], [34.14, 34.58, " all"], [34.58, 34.84, " play"], [34.84, 34.98, " a"], [34.98, 35.26, " part."], [35.98, 36.18, " What"], [36.18, 36.34, " can"], [36.34, 36.5, " you"], [36.5, 36.76, " do?"]]}, {"start": 37.52, "end": 44.2, "text": "First, know the number. Check your country's official inflation rate. Second, don't keep", "words": [[37.52, 37.82, " First,"], [38.34, 38.46, " know"], [38.46, 38.74, " the"], [38.74, 39.06, " number."], [39.76, 39.88, " Check"], [39.88, 40.12, " your"], [40.12, 40.72, " country's"], [40.72, 41.16, " official"], [41.16, 41.72, " inflation"], [41.72, 42.28, " rate."], [42.86, 43.0, " Second,"], [43.7, 43.94, " don't"], [43.94, 44.2, " keep"]]}, {"start": 44.2, "end": 50.56, "text": "long-term savings in cash under the mattress. Look for savings that pay interest, ideally", "words": [[44.2, 44.56, " long"], [44.56, 44.84, "-term"], [44.84, 45.3, " savings"], [45.3, 45.66, " in"], [45.66, 46.08, " cash"], [46.08, 46.5, " under"], [46.5, 46.64, " the"], [46.64, 47.06, " mattress."], [47.7, 47.92, " Look"], [47.92, 48.16, " for"], [48.16, 48.52, " savings"], [48.52, 48.78, " that"], [48.78, 49.06, " pay"], [49.06, 49.7, " interest,"], [50.1, 50.56, " ideally"]]}, {"start": 50.56, "end": 57.86, "text": "above inflation. Third, build skills that let you raise your income. And be careful.", "words": [[50.56, 51.32, " above"], [51.32, 52.08, " inflation."], [53.18, 53.18, " Third,"], [53.82, 53.98, " build"], [53.98, 54.48, " skills"], [54.48, 54.76, " that"], [54.76, 55.0, " let"], [55.0, 55.22, " you"], [55.22, 55.6, " raise"], [55.6, 55.86, " your"], [55.86, 56.3, " income."], [57.1, 57.14, " And"], [57.14, 57.4, " be"], [57.4, 57.86, " careful."]]}, {"start": 58.56, "end": 63.28, "text": "Inflation fear is a favorite tool of scammers selling get-rich-quick schemes.", "words": [[58.56, 59.0, " Inflation"], [59.0, 59.32, " fear"], [59.32, 59.62, " is"], [59.62, 59.82, " a"], [59.82, 60.16, " favorite"], [60.16, 60.56, " tool"], [60.56, 60.76, " of"], [60.76, 61.3, " scammers"], [61.3, 61.88, " selling"], [61.88, 62.22, " get"], [62.22, 62.5, "-rich"], [62.5, 62.8, "-quick"], [62.8, 63.28, " schemes."]]}, {"start": 63.94, "end": 67.34, "text": "Protect your money, but protect it wisely. See ya!", "words": [[63.94, 64.22, " Protect"], [64.22, 64.46, " your"], [64.46, 64.74, " money,"], [65.06, 65.22, " but"], [65.22, 65.6, " protect"], [65.6, 65.8, " it"], [65.8, 66.22, " wisely."], [67.0, 67.18, " See"], [67.18, 67.34, " ya!"]]}]