[{"start": 0.0, "end": 5.82, "text": "Hey, Cobo here, every professional trader decides where they are wrong before they enter.", "words": [[0.0, 0.24, " Hey,"], [1.2, 1.4, " Cobo"], [1.4, 1.66, " here,"], [2.18, 2.44, " every"], [2.44, 2.96, " professional"], [2.96, 3.44, " trader"], [3.44, 4.08, " decides"], [4.08, 4.38, " where"], [4.38, 4.54, " they"], [4.54, 4.66, " are"], [4.66, 4.92, " wrong"], [4.92, 5.28, " before"], [5.28, 5.48, " they"], [5.48, 5.82, " enter."]]}, {"start": 6.88, "end": 8.56, "text": "That decision is called a stop loss.", "words": [[6.88, 7.06, " That"], [7.06, 7.32, " decision"], [7.32, 7.68, " is"], [7.68, 7.9, " called"], [7.9, 8.04, " a"], [8.04, 8.3, " stop"], [8.3, 8.56, " loss."]]}, {"start": 9.68, "end": 12.02, "text": "Here's how it works, in 6 steps.", "words": [[9.68, 9.9, " Here's"], [9.9, 10.08, " how"], [10.08, 10.24, " it"], [10.24, 10.62, " works,"], [11.2, 11.4, " in"], [11.4, 11.64, " 6"], [11.64, 12.02, " steps."]]}, {"start": 13.86, "end": 14.26, "text": "Step 1.", "words": [[13.86, 13.88, " Step"], [13.88, 14.26, " 1."]]}, {"start": 15.46, "end": 19.76, "text": "A stop loss is an order that closes your position if price reaches a level you chose.", "words": [[15.46, 15.46, " A"], [15.46, 15.74, " stop"], [15.74, 15.98, " loss"], [15.98, 16.16, " is"], [16.16, 16.36, " an"], [16.36, 16.62, " order"], [16.62, 16.92, " that"], [16.92, 17.2, " closes"], [17.2, 17.46, " your"], [17.46, 17.86, " position"], [17.86, 18.16, " if"], [18.16, 18.44, " price"], [18.44, 18.8, " reaches"], [18.8, 19.02, " a"], [19.02, 19.22, " level"], [19.22, 19.46, " you"], [19.46, 19.76, " chose."]]}, {"start": 20.64, "end": 23.22, "text": "It limits how much one idea can cost you.", "words": [[20.64, 20.98, " It"], [20.98, 21.26, " limits"], [21.26, 21.56, " how"], [21.56, 21.74, " much"], [21.74, 22.0, " one"], [22.0, 22.28, " idea"], [22.28, 22.52, " can"], [22.52, 22.82, " cost"], [22.82, 23.22, " you."]]}, {"start": 24.16, "end": 24.56, "text": "Step 2.", "words": [[24.16, 24.22, " Step"], [24.22, 24.56, " 2."]]}, {"start": 24.56, "end": 29.88, "text": "Put it where your idea is proven wrong, not at a random percentage.", "words": [[24.56, 25.5, " Put"], [25.5, 25.66, " it"], [25.66, 25.94, " where"], [25.94, 26.16, " your"], [26.16, 26.58, " idea"], [26.58, 26.94, " is"], [26.94, 27.3, " proven"], [27.3, 27.76, " wrong,"], [28.36, 28.64, " not"], [28.64, 28.88, " at"], [28.88, 29.04, " a"], [29.04, 29.28, " random"], [29.28, 29.88, " percentage."]]}, {"start": 30.84, "end": 35.26, "text": "If your idea was that price holds above a level, the stop goes below that level.", "words": [[30.84, 30.98, " If"], [30.98, 31.16, " your"], [31.16, 31.38, " idea"], [31.38, 31.64, " was"], [31.64, 31.88, " that"], [31.88, 32.14, " price"], [32.14, 32.48, " holds"], [32.48, 32.84, " above"], [32.84, 33.06, " a"], [33.06, 33.36, " level,"], [33.82, 33.94, " the"], [33.94, 34.12, " stop"], [34.12, 34.32, " goes"], [34.32, 34.6, " below"], [34.6, 34.86, " that"], [34.86, 35.26, " level."]]}, {"start": 36.2, "end": 36.58, "text": "Step 3.", "words": [[36.2, 36.22, " Step"], [36.22, 36.58, " 3."]]}, {"start": 37.5, "end": 38.56, "text": "Size the trade from the stop.", "words": [[37.5, 37.52, " Size"], [37.52, 37.74, " the"], [37.74, 37.92, " trade"], [37.92, 38.16, " from"], [38.16, 38.36, " the"], [38.36, 38.56, " stop."]]}, {"start": 38.86, "end": 41.22, "text": "Decide the most you are willing to lose on one idea.", "words": [[38.86, 39.24, " Decide"], [39.24, 39.4, " the"], [39.4, 39.62, " most"], [39.62, 39.8, " you"], [39.8, 39.88, " are"], [39.88, 40.04, " willing"], [40.04, 40.28, " to"], [40.28, 40.46, " lose"], [40.46, 40.64, " on"], [40.64, 40.84, " one"], [40.84, 41.22, " idea."]]}, {"start": 41.9, "end": 44.1, "text": "Many traders use 1% of their account.", "words": [[41.9, 42.12, " Many"], [42.12, 42.4, " traders"], [42.4, 42.72, " use"], [42.72, 43.0, " 1"], [43.0, 43.32, "%"], [43.32, 43.54, " of"], [43.54, 43.74, " their"], [43.74, 44.1, " account."]]}, {"start": 44.68, "end": 48.38, "text": "The distance to your stop then tells you how big the position can be.", "words": [[44.68, 44.84, " The"], [44.84, 45.1, " distance"], [45.1, 45.34, " to"], [45.34, 45.52, " your"], [45.52, 45.74, " stop"], [45.74, 46.0, " then"], [46.0, 46.26, " tells"], [46.26, 46.52, " you"], [46.52, 46.82, " how"], [46.82, 47.06, " big"], [47.06, 47.24, " the"], [47.24, 47.6, " position"], [47.6, 47.94, " can"], [47.94, 48.38, " be."]]}, {"start": 49.22, "end": 49.62, "text": "Step 4.", "words": [[49.22, 49.26, " Step"], [49.26, 49.62, " 4."]]}, {"start": 50.26, "end": 51.02, "text": "Know the limits.", "words": [[50.26, 50.52, " Know"], [50.52, 50.74, " the"], [50.74, 51.02, " limits."]]}, {"start": 51.68, "end": 57.74, "text": "In a fast crash, price can jump past your stop so you may get fueled lower than you planned.", "words": [[51.68, 52.28, " In"], [52.28, 52.44, " a"], [52.44, 52.66, " fast"], [52.66, 53.0, " crash,"], [53.16, 53.3, " price"], [53.3, 53.58, " can"], [53.58, 53.9, " jump"], [53.9, 54.14, " past"], [54.14, 54.36, " your"], [54.36, 54.6, " stop"], [54.6, 55.22, " so"], [55.22, 55.36, " you"], [55.36, 55.46, " may"], [55.46, 55.7, " get"], [55.7, 56.06, " fueled"], [56.06, 56.56, " lower"], [56.56, 57.02, " than"], [57.02, 57.18, " you"], [57.18, 57.74, " planned."]]}, {"start": 58.66, "end": 59.04, "text": "Step 5.", "words": [[58.66, 58.68, " Step"], [58.68, 59.04, " 5."]]}, {"start": 59.52, "end": 61.9, "text": "Don't move your stop further away because you hope.", "words": [[59.52, 59.84, " Don't"], [59.84, 59.98, " move"], [59.98, 60.18, " your"], [60.18, 60.44, " stop"], [60.44, 60.7, " further"], [60.7, 61.12, " away"], [61.12, 61.44, " because"], [61.44, 61.66, " you"], [61.66, 61.9, " hope."]]}, {"start": 62.86, "end": 64.92, "text": "That's how small losses become big ones.", "words": [[62.86, 63.1, " That's"], [63.1, 63.26, " how"], [63.26, 63.54, " small"], [63.54, 63.84, " losses"], [63.84, 64.2, " become"], [64.2, 64.46, " big"], [64.46, 64.92, " ones."]]}, {"start": 65.52, "end": 65.96, "text": "Step 6.", "words": [[65.52, 65.58, " Step"], [65.58, 65.96, " 6."]]}, {"start": 66.84, "end": 68.56, "text": "Write it down before you click buy.", "words": [[66.84, 66.96, " Write"], [66.96, 67.2, " it"], [67.2, 67.46, " down"], [67.46, 67.8, " before"], [67.8, 67.96, " you"], [67.96, 68.22, " click"], [68.22, 68.56, " buy."]]}, {"start": 69.24, "end": 71.24, "text": "Entry, stop and why.", "words": [[69.24, 69.56, " Entry,"], [70.2, 70.3, " stop"], [70.3, 70.94, " and"], [70.94, 71.24, " why."]]}, {"start": 71.96, "end": 73.8, "text": "Scenarios, not certainties.", "words": [[71.96, 72.46, " Scenarios,"], [73.06, 73.1, " not"], [73.1, 73.8, " certainties."]]}, {"start": 74.72, "end": 76.32, "text": "Education, not financial advice.", "words": [[74.72, 75.08, " Education,"], [75.36, 75.44, " not"], [75.44, 75.92, " financial"], [75.92, 76.32, " advice."]]}, {"start": 77.0, "end": 78.16, "text": "Subscribe for the next how to.", "words": [[77.0, 77.12, " Subscribe"], [77.12, 77.46, " for"], [77.46, 77.58, " the"], [77.58, 77.78, " next"], [77.78, 77.98, " how"], [77.98, 78.16, " to."]]}]