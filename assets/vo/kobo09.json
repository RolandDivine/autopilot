[{"start": 0.0, "end": 0.88, "text": "Hey, it's Kobo.", "words": [[0.0, 0.28, " Hey,"], [0.44, 0.62, " it's"], [0.62, 0.88, " Kobo."]]}, {"start": 1.66, "end": 3.26, "text": "Ada keeps hearing about Bitcoin.", "words": [[1.66, 1.76, " Ada"], [1.76, 2.06, " keeps"], [2.06, 2.42, " hearing"], [2.42, 2.74, " about"], [2.74, 3.26, " Bitcoin."]]}, {"start": 3.86, "end": 6.22, "text": "Today she asks, what is it really?", "words": [[3.86, 4.02, " Today"], [4.02, 4.24, " she"], [4.24, 4.68, " asks,"], [5.28, 5.3, " what"], [5.3, 5.58, " is"], [5.58, 5.76, " it"], [5.76, 6.22, " really?"]]}, {"start": 7.4, "end": 10.24, "text": "Imagine a notebook that records every payment.", "words": [[7.4, 7.54, " Imagine"], [7.54, 7.9, " a"], [7.9, 8.32, " notebook"], [8.32, 8.68, " that"], [8.68, 9.12, " records"], [9.12, 9.74, " every"], [9.74, 10.24, " payment."]]}, {"start": 10.88, "end": 14.24, "text": "Now imagine thousands of computers around the world,", "words": [[10.88, 11.12, " Now"], [11.12, 11.62, " imagine"], [11.62, 12.3, " thousands"], [12.3, 12.74, " of"], [12.74, 13.16, " computers"], [13.16, 13.66, " around"], [13.66, 13.86, " the"], [13.86, 14.24, " world,"]]}, {"start": 14.66, "end": 16.72, "text": "each holding a copy of that notebook.", "words": [[14.66, 14.88, " each"], [14.88, 15.22, " holding"], [15.22, 15.44, " a"], [15.44, 15.78, " copy"], [15.78, 16.1, " of"], [16.1, 16.3, " that"], [16.3, 16.72, " notebook."]]}, {"start": 17.4, "end": 20.54, "text": "No bank owns it, no government controls it.", "words": [[17.4, 17.62, " No"], [17.62, 17.88, " bank"], [17.88, 18.18, " owns"], [18.18, 18.5, " it,"], [18.9, 19.06, " no"], [19.06, 19.42, " government"], [19.42, 20.14, " controls"], [20.14, 20.54, " it."]]}, {"start": 20.9, "end": 24.02, "text": "To cheat, you'd have to fool most of those computers", "words": [[20.9, 21.1, " To"], [21.1, 21.44, " cheat,"], [21.88, 22.02, " you'd"], [22.02, 22.18, " have"], [22.18, 22.34, " to"], [22.34, 22.66, " fool"], [22.66, 23.1, " most"], [23.1, 23.32, " of"], [23.32, 23.52, " those"], [23.52, 24.02, " computers"]]}, {"start": 24.02, "end": 24.94, "text": "at once.", "words": [[24.02, 24.44, " at"], [24.44, 24.94, " once."]]}, {"start": 25.58, "end": 28.42, "text": "That shared notebook is called a blockchain.", "words": [[25.58, 25.92, " That"], [25.92, 26.28, " shared"], [26.28, 26.76, " notebook"], [26.76, 27.18, " is"], [27.18, 27.58, " called"], [27.58, 27.9, " a"], [27.9, 28.42, " blockchain."]]}, {"start": 29.28, "end": 32.02, "text": "Bitcoin is the money that lives on it.", "words": [[29.28, 29.78, " Bitcoin"], [29.78, 30.26, " is"], [30.26, 30.42, " the"], [30.42, 30.72, " money"], [30.72, 31.04, " that"], [31.04, 31.32, " lives"], [31.32, 31.58, " on"], [31.58, 32.02, " it."]]}, {"start": 32.6, "end": 34.5, "text": "Two things make Bitcoin different.", "words": [[32.6, 32.68, " Two"], [32.68, 33.08, " things"], [33.08, 33.44, " make"], [33.44, 33.98, " Bitcoin"], [33.98, 34.5, " different."]]}, {"start": 35.52, "end": 40.04, "text": "One, there will only ever be 21 million Bitcoin.", "words": [[35.52, 35.52, " One,"], [36.08, 36.12, " there"], [36.12, 36.3, " will"], [36.3, 36.8, " only"], [36.8, 37.18, " ever"], [37.18, 37.54, " be"], [37.54, 38.42, " 21"], [38.42, 39.36, " million"], [39.36, 40.04, " Bitcoin."]]}, {"start": 40.62, "end": 42.14, "text": "Nobody can print more.", "words": [[40.62, 41.0, " Nobody"], [41.0, 41.46, " can"], [41.46, 41.76, " print"], [41.76, 42.14, " more."]]}, {"start": 42.62, "end": 45.84, "text": "Two, you can send it to anyone, anywhere,", "words": [[42.62, 42.96, " Two,"], [43.48, 43.64, " you"], [43.64, 43.82, " can"], [43.82, 44.12, " send"], [44.12, 44.3, " it"], [44.3, 44.48, " to"], [44.48, 45.12, " anyone,"], [45.46, 45.84, " anywhere,"]]}, {"start": 46.36, "end": 47.68, "text": "without asking a bank.", "words": [[46.36, 46.72, " without"], [46.72, 47.28, " asking"], [47.28, 47.44, " a"], [47.44, 47.68, " bank."]]}, {"start": 48.42, "end": 49.84, "text": "But here's the honest part.", "words": [[48.42, 48.54, " But"], [48.54, 48.88, " here's"], [48.88, 49.06, " the"], [49.06, 49.4, " honest"], [49.4, 49.84, " part."]]}, {"start": 50.48, "end": 52.92, "text": "Bitcoin's price moves a lot.", "words": [[50.48, 51.06, " Bitcoin's"], [51.06, 51.4, " price"], [51.4, 52.16, " moves"], [52.16, 52.52, " a"], [52.52, 52.92, " lot."]]}, {"start": 53.48, "end": 56.38, "text": "It has dropped more than 70% before.", "words": [[53.48, 53.72, " It"], [53.72, 53.9, " has"], [53.9, 54.22, " dropped"], [54.22, 54.54, " more"], [54.54, 54.76, " than"], [54.76, 55.38, " 70"], [55.38, 55.86, "%"], [55.86, 56.38, " before."]]}, {"start": 56.96, "end": 58.64, "text": "So it can be part of a plan,", "words": [[56.8, 57.1, " So"], [57.1, 57.26, " it"], [57.26, 57.56, " can"], [57.56, 57.78, " be"], [57.78, 58.02, " part"], [58.02, 58.16, " of"], [58.16, 58.3, " a"], [58.3, 58.64, " plan,"]]}, {"start": 59.0, "end": 62.92, "text": "but never your rent money and never your emergency fund.", "words": [[59.0, 59.26, " but"], [59.26, 59.64, " never"], [59.64, 59.96, " your"], [59.96, 60.26, " rent"], [60.26, 60.6, " money"], [60.6, 61.14, " and"], [61.14, 61.54, " never"], [61.54, 61.96, " your"], [61.96, 62.44, " emergency"], [62.44, 62.92, " fund."]]}, {"start": 63.56, "end": 66.86, "text": "Next time, if you own crypto, where do you keep it?", "words": [[63.56, 63.64, " Next"], [63.64, 63.96, " time,"], [64.28, 64.5, " if"], [64.5, 64.7, " you"], [64.7, 64.96, " own"], [64.96, 65.42, " crypto,"], [65.96, 66.08, " where"], [66.08, 66.24, " do"], [66.24, 66.36, " you"], [66.36, 66.58, " keep"], [66.58, 66.86, " it?"]]}, {"start": 67.4, "end": 69.44, "text": "The answer matters more than you think.", "words": [[67.4, 67.52, " The"], [67.52, 67.86, " answer"], [67.86, 68.4, " matters"], [68.4, 68.78, " more"], [68.78, 69.0, " than"], [69.0, 69.16, " you"], [69.16, 69.44, " think."]]}, {"start": 70.0, "end": 70.36, "text": "See ya.", "words": [[70.0, 70.2, " See"], [70.2, 70.36, " ya."]]}]