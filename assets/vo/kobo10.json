[{"start": 0.0, "end": 5.2, "text": "Hey, it's Kobo. Ada bought a little Bitcoin. Now, where does she keep it?", "words": [[0.0, 0.3, " Hey,"], [0.52, 0.74, " it's"], [0.74, 1.0, " Kobo."], [1.7, 1.8, " Ada"], [1.8, 2.16, " bought"], [2.16, 2.4, " a"], [2.4, 2.68, " little"], [2.68, 3.12, " Bitcoin."], [3.84, 3.86, " Now,"], [4.08, 4.34, " where"], [4.34, 4.46, " does"], [4.46, 4.62, " she"], [4.62, 4.82, " keep"], [4.82, 5.2, " it?"]]}, {"start": 6.12, "end": 11.78, "text": "Option one. On the exchange where she bought it. Easy. But the exchange holds the keys.", "words": [[6.12, 6.12, " Option"], [6.12, 6.42, " one."], [6.84, 7.02, " On"], [7.02, 7.14, " the"], [7.14, 7.56, " exchange"], [7.56, 7.96, " where"], [7.96, 8.16, " she"], [8.16, 8.38, " bought"], [8.38, 8.74, " it."], [8.92, 9.12, " Easy."], [9.8, 9.9, " But"], [9.9, 10.04, " the"], [10.04, 10.56, " exchange"], [10.56, 11.18, " holds"], [11.18, 11.46, " the"], [11.46, 11.78, " keys."]]}, {"start": 12.34, "end": 18.64, "text": "If it gets hacked or goes bust like FTX in 2022, her coins can get stuck.", "words": [[12.34, 12.58, " If"], [12.58, 12.68, " it"], [12.68, 12.86, " gets"], [12.86, 13.24, " hacked"], [13.24, 13.68, " or"], [13.68, 13.96, " goes"], [13.96, 14.34, " bust"], [14.34, 14.9, " like"], [14.9, 15.52, " FTX"], [15.52, 15.66, " in"], [15.66, 16.36, " 2022,"], [16.9, 17.14, " her"], [17.14, 17.62, " coins"], [17.62, 17.96, " can"], [17.96, 18.16, " get"], [18.16, 18.64, " stuck."]]}, {"start": 19.86, "end": 28.68, "text": "Option two. Her own wallet. A wallet doesn't hold coins. It holds keys. The passwords that prove", "words": [[19.86, 19.86, " Option"], [19.86, 20.24, " two."], [20.78, 20.88, " Her"], [20.88, 21.32, " own"], [21.32, 21.96, " wallet."], [22.56, 22.78, " A"], [22.78, 23.2, " wallet"], [23.2, 23.88, " doesn't"], [23.88, 24.16, " hold"], [24.16, 24.66, " coins."], [25.26, 25.46, " It"], [25.46, 25.94, " holds"], [25.94, 26.46, " keys."], [27.14, 27.24, " The"], [27.24, 27.8, " passwords"], [27.8, 28.3, " that"], [28.3, 28.68, " prove"]]}, {"start": 28.68, "end": 37.88, "text": "the coins are yours. When she creates one, she gets a seed phrase. 12 or 24 words. Those words", "words": [[28.68, 28.9, " the"], [28.9, 29.3, " coins"], [29.3, 29.66, " are"], [29.66, 30.04, " yours."], [30.76, 30.96, " When"], [30.96, 31.2, " she"], [31.2, 31.6, " creates"], [31.6, 31.94, " one,"], [32.32, 32.42, " she"], [32.42, 32.66, " gets"], [32.66, 32.9, " a"], [32.9, 33.28, " seed"], [33.28, 33.76, " phrase."], [34.42, 34.76, " 12"], [34.76, 35.26, " or"], [35.26, 35.9, " 24"], [35.9, 36.42, " words."], [37.18, 37.52, " Those"], [37.52, 37.88, " words"]]}, {"start": 37.88, "end": 47.04, "text": "are everything. Whoever has them has the money. So, Kobo's rules. Write the seed phrase on paper.", "words": [[37.88, 38.38, " are"], [38.38, 39.08, " everything."], [39.84, 40.06, " Whoever"], [40.06, 40.48, " has"], [40.48, 40.84, " them"], [40.84, 41.38, " has"], [41.38, 41.68, " the"], [41.68, 41.96, " money."], [42.6, 42.94, " So,"], [43.5, 43.94, " Kobo's"], [43.94, 44.2, " rules."], [45.0, 45.28, " Write"], [45.28, 45.54, " the"], [45.54, 45.78, " seed"], [45.78, 46.22, " phrase"], [46.22, 46.58, " on"], [46.58, 47.04, " paper."]]}, {"start": 47.66, "end": 53.68, "text": "Never in a screenshot. Never in the cloud. Never in a chat. Keep it somewhere safe.", "words": [[47.66, 47.98, " Never"], [47.98, 48.24, " in"], [48.24, 48.44, " a"], [48.44, 48.82, " screenshot."], [49.3, 49.64, " Never"], [49.64, 49.9, " in"], [49.9, 50.02, " the"], [50.02, 50.36, " cloud."], [50.9, 51.08, " Never"], [51.08, 51.38, " in"], [51.38, 51.52, " a"], [51.52, 51.8, " chat."], [52.46, 52.66, " Keep"], [52.66, 52.88, " it"], [52.88, 53.26, " somewhere"], [53.26, 53.68, " safe."]]}, {"start": 53.68, "end": 62.58, "text": "And never, ever type it into a website or give it to anyone. No real support agent will ever ask for it.", "words": [[53.68, 54.36, " And"], [54.36, 54.84, " n