[{"start": 0.0, "end": 0.98, "text": "Hey, it's Kobo.", "words": [[0.0, 0.28, " Hey,"], [0.52, 0.78, " it's"], [0.78, 0.98, " Kobo."]]}, {"start": 1.74, "end": 4.66, "text": "Ada's cousin Femi designs logos for clients abroad.", "words": [[1.74, 2.02, " Ada's"], [2.02, 2.22, " cousin"], [2.22, 2.7, " Femi"], [2.7, 3.16, " designs"], [3.16, 3.5, " logos"], [3.5, 3.92, " for"], [3.92, 4.28, " clients"], [4.28, 4.66, " abroad."]]}, {"start": 5.38, "end": 8.9, "text": "Getting paid used to take days and cost a lot in fees.", "words": [[5.38, 5.54, " Getting"], [5.54, 5.9, " paid"], [5.9, 6.2, " used"], [6.2, 6.38, " to"], [6.38, 6.6, " take"], [6.6, 7.0, " days"], [7.0, 7.42, " and"], [7.42, 7.7, " cost"], [7.7, 7.96, " a"], [7.96, 8.32, " lot"], [8.32, 8.62, " in"], [8.62, 8.9, " fees."]]}, {"start": 9.62, "end": 12.0, "text": "Now his clients pay him in a stablecoin.", "words": [[9.62, 9.9, " Now"], [9.9, 10.12, " his"], [10.12, 10.48, " clients"], [10.48, 10.76, " pay"], [10.76, 10.98, " him"], [10.98, 11.22, " in"], [11.22, 11.46, " a"], [11.46, 12.0, " stablecoin."]]}, {"start": 12.64, "end": 16.8, "text": "A stablecoin is a crypto token built to stay at $1.", "words": [[12.64, 12.8, " A"], [12.8, 13.46, " stablecoin"], [13.46, 13.82, " is"], [13.82, 14.04, " a"], [14.04, 14.3, " crypto"], [14.3, 14.74, " token"], [14.74, 15.26, " built"], [15.26, 15.52, " to"], [15.52, 15.88, " stay"], [15.88, 16.16, " at"], [16.16, 16.8, " $1."]]}, {"start": 17.5, "end": 19.72, "text": "The company behind it holds reserves,", "words": [[17.5, 17.9, " The"], [17.9, 18.18, " company"], [18.18, 18.62, " behind"], [18.62, 18.84, " it"], [18.84, 19.2, " holds"], [19.2, 19.72, " reserves,"]]}, {"start": 20.06, "end": 22.82, "text": "like cash and short-term government bonds,", "words": [[20.06, 20.32, " like"], [20.32, 20.74, " cash"], [20.74, 21.26, " and"], [21.26, 21.54, " short"], [21.54, 21.86, "-term"], [21.86, 22.26, " government"], [22.26, 22.82, " bonds,"]]}, {"start": 22.92, "end": 24.46, "text": "to back each coin.", "words": [[22.92, 23.3, " to"], [23.3, 23.58, " back"], [23.58, 24.02, " each"], [24.02, 24.46, " coin."]]}, {"start": 25.16, "end": 27.02, "text": "So Femi gets paid in minutes,", "words": [[25.16, 25.38, " So"], [25.38, 25.74, " Femi"], [25.74, 25.96, " gets"], [25.96, 26.28, " paid"], [26.28, 26.6, " in"], [26.6, 27.02, " minutes,"]]}, {"start": 27.02, "end": 29.94, "text": "and the value doesn't swing like Bitcoin.", "words": [[27.02, 27.58, " and"], [27.58, 27.72, " the"], [27.72, 28.16, " value"], [28.16, 28.66, " doesn't"], [28.66, 29.06, " swing"], [29.06, 29.5, " like"], [29.5, 29.94, " Bitcoin."]]}, {"start": 30.66, "end": 33.18, "text": "But stable doesn't mean risk-free.", "words": [[30.66, 30.92, " But"], [30.92, 31.36, " stable"], [31.36, 32.08, " doesn't"], [32.08, 32.4, " mean"], [32.4, 32.8, " risk"], [32.8, 33.18, "-free."]]}, {"start": 33.74, "end": 36.32, "text": "The company keeps the interest from those reserves,", "words": [[33.74, 33.94, " The"], [33.94, 34.2, " company"], [34.2, 34.68, " keeps"], [34.68, 34.92, " the"], [34.92, 35.3, " interest"], [35.3, 35.58, " from"], [35.58, 35.82, " those"], [35.82, 36.32, " reserves,"]]}, {"start": 36.74, "end": 37.48, "text": "not Femi.", "words": [[36.74, 37.08, " not"], [37.08, 37.48, " Femi."]]}, {"start": 38.0, "end": 39.6, "text": "And if the reserves have a problem,", "words": [[38.0, 38.16, " And"], [38.16, 38.28, " if"], [38.28, 38.42, " the"], [38.42, 38.8, " reserves"], [38.8, 39.04, " have"], [39.04, 39.22, " a"], [39.22, 39.6, " problem,"]]}, {"start": 39.96, "end": 42.22, "text": "the coin can slip below a dollar.", "words": [[39.96, 40.16, " the"], [40.16, 40.48, " coin"], [40.48, 40.76, " can"], [40.76, 41.14, " slip"], [41.14, 41.66, " below"], [41.66, 41.94, " a"], [41.94, 42.22, " dollar."]]}, {"start": 42.88, "end": 44.28, "text": "It has happened before.", "words": [[42.88, 43.04, " It"], [43.04, 43.36, " has"], [43.36, 43.78, " happened"], [43.78, 44.28, " before."]]}, {"start": 45.0, "end": 45.72, "text": "Femi's rules.", "words": [[45.0, 45.44, " Femi's"], [45.44, 45.72, " rules."]]}, {"start": 46.58, "end": 49.2, "text": "Use the big, regulated stablecoins.", "words": [[46.58, 46.8, " Use"], [46.8, 47.08, " the"], [47.08, 47.46, " big,"], [47.7, 48.36, " regulated"], [48.36, 49.2, " stablecoins."]]}, {"start": 49.84, "end": 52.08, "text": "Check the fees before you cash out.", "words": [[49.84, 50.08, " Check"], [50.08, 50.32, " the"], [50.32, 50.64, " fees"], [50.64, 51.18, " before"], [51.18, 51.44, " you"], [51.44, 51.7, " cash"], [51.7, 52.08, " out."]]}, {"start": 52.46, "end": 54.36, "text": "And don't leave large amounts", "words": [[52.46, 52.78, " And"], [52.78, 53.16, " don't"], [53.16, 53.46, " leave"], [53.46, 53.86, " large"], [53.86, 54.36, " amounts"]]}, {"start": 54.36, "end": 56.58, "text": "sitting on an exchange for months.", "words": [[54.36, 54.8, " sitting"], [54.8, 55.08, " on"], [55.08, 55.22, " an"], [55.22, 55.74, " exchange"], [55.74, 56.16, " for"], [56.16, 56.58, " months."]]}, {"start": 57.22, "end": 60.44, "text": "A stablecoin is a tool for moving money.", "words": [[57.22, 57.52, " A"], [57.52, 58.26, " stablecoin"], [58.26, 58.72, " is"], [58.72, 58.94, " a"], [58.94, 59.18, " tool"], [59.18, 59.64, " for"], [59.64, 60.04, " moving"], [60.04, 60.44, " money."]]}, {"start": 61.02, "end": 62.4, "text": "It isn't a savings account.", "words": [[61.02, 61.1, " It"], [61.1, 61.52, " isn't"], [61.52, 61.72, " a"], [61.72, 62.0, " savings"], [62.0, 62.4, " account."]]}, {"start": 63.16, "end": 65.7, "text": "Next time, should Ada buy all at once", "words": [[63.16, 63.3, " Next"], [63.3, 63.7, " time,"], [64.04, 64.18, " should"], [64.18, 64.46, " Ada"], [64.46, 64.8, " buy"], [64.8, 65.2, " all"], [65.2, 65.36, " at"], [65.36, 65.7, " once"]]}, {"start": 65.7, "end": 67.5, "text": "or a little every month?", "words": [[65.7, 66.28, " or"], [66.28, 66.42, " a"], [66.42, 66.62, " little"], [66.62, 67.16, " every"], [67.16, 67.5, " month?"]]}, {"start": 68.18, "end": 68.48, "text": "See ya.", "words": [[68.18, 68.34, " See"], [68.34, 68.48, " ya."]]}]