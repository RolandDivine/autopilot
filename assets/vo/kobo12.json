[{"start": 0.0, "end": 5.98, "text": "Hey, it's Kobo. Ada has $600 to invest. Does she put it all in today?", "words": [[0.0, 0.3, " Hey,"], [0.62, 0.88, " it's"], [0.88, 1.14, " Kobo."], [1.92, 2.0, " Ada"], [2.0, 2.3, " has"], [2.3, 2.96, " $600"], [2.96, 3.54, " to"], [3.54, 3.88, " invest."], [4.58, 4.68, " Does"], [4.68, 4.84, " she"], [4.84, 5.02, " put"], [5.02, 5.16, " it"], [5.16, 5.42, " all"], [5.42, 5.64, " in"], [5.64, 5.98, " today?"]]}, {"start": 6.86, "end": 12.66, "text": "Her friend Tunde tries to time the market. He waits for the perfect dip. The dip comes,", "words": [[6.86, 6.96, " Her"], [6.96, 7.22, " friend"], [7.22, 7.68, " Tunde"], [7.68, 8.08, " tries"], [8.08, 8.36, " to"], [8.36, 8.58, " time"], [8.58, 8.74, " the"], [8.74, 9.04, " market."], [9.66, 9.74, " He"], [9.74, 10.0, " waits"], [10.0, 10.26, " for"], [10.26, 10.42, " the"], [10.42, 10.82, " perfect"], [10.82, 11.18, " dip."], [11.86, 12.0, " The"], [12.0, 12.2, " dip"], [12.2, 12.66, " comes,"]]}, {"start": 13.06, "end": 20.92, "text": "he waits for a lower one. Prices go up, he never buys. Ada does something boring instead. $100", "words": [[13.06, 13.18, " he"], [13.18, 13.4, " waits"], [13.4, 13.64, " for"], [13.64, 13.78, " a"], [13.78, 13.94, " lower"], [13.94, 14.26, " one."], [14.96, 15.06, " Prices"], [15.06, 15.38, " go"], [15.38, 15.66, " up,"], [16.0, 16.16, " he"], [16.16, 16.58, " never"], [16.58, 16.9, " buys."], [17.64, 17.96, " Ada"], [17.96, 18.24, " does"], [18.24, 18.6, " something"], [18.6, 19.1, " boring"], [19.1, 19.74, " instead."], [20.48, 20.92, " $100"]]}, {"start": 21.52, "end": 28.44, "text": "on the same day, every month, for six months. When prices are high, her hundred buys less.", "words": [[21.42, 21.74, " on"], [21.74, 21.9, " the"], [21.9, 22.22, " same"], [22.22, 22.62, " day,"], [22.98, 23.32, " every"], [23.32, 23.68, " month,"], [23.94, 24.16, " for"], [24.16, 24.52, " six"], [24.52, 24.84, " months."], [25.6, 25.78, " When"], [25.78, 26.12, " prices"], [26.12, 26.36, " are"], [26.36, 26.68, " high,"], [27.0, 27.22, " her"], [27.22, 27.62, " hundred"], [27.62, 28.08, " buys"], [28.08, 28.44, " less."]]}, {"start": 29.08, "end": 36.74, "text": "When prices are low, it buys more. That's called dollar-cost averaging. It doesn't promise profit,", "words": [[29.02, 29.36, " When"], [29.36, 29.68, " prices"], [29.68, 29.96, " are"], [29.96, 30.28, " low,"], [30.68, 30.8, " it"], [30.8, 31.04, " buys"], [31.04, 31.52, " more."], [32.14, 32.58, " That's"], [32.58, 32.9, " called"], [32.9, 33.48, " dollar"], [33.48, 33.92, "-cost"], [33.92, 34.62, " averaging."], [35.34, 35.48, " It"], [35.48, 35.84, " doesn't"], [35.84, 36.2, " promise"], [36.2, 36.74, " profit,"]]}, {"start": 37.04, "end": 42.64, "text": "but it takes away the stress of guessing and stops you from putting everything in at the top.", "words": [[37.04, 37.2, " but"], [37.2, 37.34, " it"], [37.34, 37.56, " takes"], [37.56, 37.84, " away"], [37.84, 38.0, " the"], [38.0, 38.38, " stress"], [38.38, 38.66, " of"], [38.66, 39.06, " guessing"], [39.06, 39.74, " and"], [39.74, 40.1, " stops"], [40.1, 40.36, " you"], [40.36, 40.56, " from"], [40.56, 40.82, " putting"], [40.82, 41.36, " everything"], [41.36, 41.84, " in"], [41.84, 42.16, " at"], [42.16, 42.3, " the"], [42.3, 42.64, " top."]]}, {"start": 43.52, "end": 50.12, "text": "Two rules. Only invest money you won't need for years and pick something you understand,", "words": [[43.52, 43.7, " Two"], [43.7, 44.12, " rules."], [44.86, 45.16, " Only"], [45.16, 45.52, " invest"], [45.52, 45.9, " money"], [45.9, 46.24, " you"], [46.24, 46.66, " won't"], [46.66, 46.94, " need"], [46.94, 47.24, " for"], [47.24, 47.66, " years"], [47.66, 48.46, " and"], [48.46, 48.74, " pick"], [48.74, 49.08, " something"], [49.08, 49.38, " you"], [49.38, 50.12, " understand,"]]}, {"start": 50.54, "end": 57.0, "text": "not whatever is trending on social media this week. Time in the market usually beats timing", "words": [[50.54, 50.94, " not"], [50.94, 51.24, " whatever"], [51.24, 51.5, " is"], [51.5, 51.88, " trending"], [51.88, 52.16, " on"], [52.16, 52.52, " social"], [52.52, 52.82, " media"], [52.82, 53.14, " this"], [53.14, 53.46, " week."], [54.34, 54.5, " Time"], [54.5, 54.64, " in"], [54.64, 54.76, " the"], [54.76, 55.12, " market"], [55.12, 55.68, " usually"], [55.68, 56.42, " beats"], [56.42, 57.0, " timing"]]}, {"start": 57.0, "end": 63.2, "text": "the market. Next time, why Ada never puts all her eggs in one basket. See ya!", "words": [[57.0, 57.26, " the"], [57.26, 57.6, " market."], [58.2, 58.3, " Next"], [58.3, 58.64, " time,"], [59.16, 59.24, " why"], [59.24, 59.56, " Ada"], [59.56, 60.02, " never"], [60.02, 60.32, " puts"], [60.32, 60.7, " all"], [60.7, 60.9, " her"], [60.9, 61.22, " eggs"], [61.22, 61.5, " in"], [61.5, 61.82, " one"], [61.82, 62.34, " basket."], [62.86, 63.04, " See"], [63.04, 63.2, " ya!"]]}]