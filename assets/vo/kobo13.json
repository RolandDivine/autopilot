[{"start": 0.0, "end": 1.16, "text": "Hey, it's Kobo.", "words": [[0.0, 0.3, " Hey,"], [0.64, 0.86, " it's"], [0.86, 1.16, " Kobo."]]}, {"start": 1.82, "end": 4.7, "text": "Ameka put all his savings into one coin.", "words": [[1.82, 2.06, " Ameka"], [2.06, 2.34, " put"], [2.34, 2.72, " all"], [2.72, 2.96, " his"], [2.96, 3.32, " savings"], [3.32, 3.72, " into"], [3.72, 4.18, " one"], [4.18, 4.7, " coin."]]}, {"start": 5.26, "end": 7.66, "text": "A friend said it would go 10 times.", "words": [[5.26, 5.42, " A"], [5.42, 5.66, " friend"], [5.66, 5.96, " said"], [5.96, 6.22, " it"], [6.22, 6.34, " would"], [6.34, 6.58, " go"], [6.58, 6.96, " 10"], [6.96, 7.66, " times."]]}, {"start": 8.34, "end": 11.04, "text": "It went down 90% in a month.", "words": [[8.34, 8.48, " It"], [8.48, 8.7, " went"], [8.7, 9.0, " down"], [9.0, 9.58, " 90"], [9.58, 10.02, "%"], [10.02, 10.54, " in"], [10.54, 10.74, " a"], [10.74, 11.04, " month."]]}, {"start": 12.08, "end": 13.1, "text": "Ada spreads hers out.", "words": [[12.08, 12.08, " Ada"], [12.08, 12.5, " spreads"], [12.5, 12.74, " hers"], [12.74, 13.1, " out."]]}, {"start": 13.74, "end": 16.8, "text": "Summon savings, summon a fund that holds many companies.", "words": [[13.74, 13.74, " Summon"], [13.74, 14.22, " savings,"], [14.72, 14.96, " summon"], [14.96, 15.14, " a"], [15.14, 15.36, " fund"], [15.36, 15.6, " that"], [15.6, 15.9, " holds"], [15.9, 16.3, " many"], [16.3, 16.8, " companies."]]}, {"start": 17.3, "end": 18.88, "text": "A small slice in crypto.", "words": [[17.3, 17.46, " A"], [17.46, 17.78, " small"], [17.78, 18.12, " slice"], [18.12, 18.52, " in"], [18.52, 18.88, " crypto."]]}, {"start": 19.56, "end": 22.62, "text": "If one falls, the others can hold her up.", "words": [[19.56, 19.78, " If"], [19.78, 20.08, " one"], [20.08, 20.52, " falls,"], [20.98, 21.04, " the"], [21.04, 21.4, " others"], [21.4, 21.82, " can"], [21.82, 22.14, " hold"], [22.14, 22.34, " her"], [22.34, 22.62, " up."]]}, {"start": 23.16, "end": 24.66, "text": "That's diversification.", "words": [[23.16, 23.68, " That's"], [23.68, 24.66, " diversification."]]}, {"start": 25.4, "end": 27.88, "text": "Don't put all your eggs in one basket.", "words": [[25.4, 25.66, " Don't"], [25.66, 25.82, " put"], [25.82, 26.18, " all"], [26.18, 26.38, " your"], [26.38, 26.7, " eggs"], [26.7, 27.04, " in"], [27.04, 27.38, " one"], [27.38, 27.88, " basket."]]}, {"start": 28.56, "end": 31.68, "text": "It works because different things move differently.", "words": [[28.3, 28.64, " It"], [28.64, 29.06, " works"], [29.06, 29.52, " because"], [29.52, 30.0, " different"], [30.0, 30.46, " things"], [30.46, 30.96, " move"], [30.96, 31.68, " differently."]]}, {"start": 32.38, "end": 35.52, "text": "When shares fall, government bonds sometimes rise.", "words": [[32.38, 32.44, " When"], [32.44, 32.78, " shares"], [32.78, 33.22, " fall,"], [33.9, 33.9, " government"], [33.9, 34.44, " bonds"], [34.44, 35.06, " sometimes"], [35.06, 35.52, " rise."]]}, {"start": 36.08, "end": 39.36, "text": "When one coin collapses, cash doesn't care.", "words": [[36.08, 36.32, " When"], [36.32, 36.66, " one"], [36.66, 36.98, " coin"], [36.98, 37.56, " collapses,"], [38.2, 38.34, " cash"], [38.34, 39.08, " doesn't"], [39.08, 39.36, " care."]]}, {"start": 40.2, "end": 42.16, "text": "Three questions before you invest.", "words": [[40.2, 40.36, " Three"], [40.36, 40.86, " questions"], [40.86, 41.52, " before"], [41.52, 41.76, " you"], [41.76, 42.16, " invest."]]}, {"start": 43.06, "end": 44.06, "text": "How much could I lose?", "words": [[43.06, 43.16, " How"], [43.16, 43.36, " much"], [43.36, 43.62, " could"], [43.62, 43.78, " I"], [43.78, 44.06, " lose?"]]}, {"start": 44.78, "end": 47.78, "text": "What else do I own that moves the same way?", "words": [[44.78, 45.06, " What"], [45.06, 45.3, " else"], [45.3, 45.52, " do"], [45.52, 45.66, " I"], [45.66, 46.02, " own"], [46.02, 46.3, " that"], [46.3, 46.76, " moves"], [46.76, 47.0, " the"], [47.0, 47.38, " same"], [47.38, 47.78, " way?"]]}, {"start": 48.28, "end": 51.16, "text": "And would I be okay if this went to zero?", "words": [[48.28, 48.52, " And"], [48.52, 48.74, " would"], [48.74, 48.92, " I"], [48.92, 49.1, " be"], [49.1, 49.5, " okay"], [49.5, 49.88, " if"], [49.88, 50.26, " this"], [50.26, 50.56, " went"], [50.56, 50.84, " to"], [50.84, 51.16, " zero?"]]}, {"start": 52.08, "end": 54.54, "text": "Spreading out won't make you rich overnight.", "words": [[52.08, 52.4, " Spreading"], [52.4, 52.74, " out"], [52.74, 53.24, " won't"], [53.24, 53.44, " make"], [53.44, 53.68, " you"], [53.68, 54.0, " rich"], [54.0, 54.54, " overnight."]]}, {"start": 55.06, "end": 57.24, "text": "It keeps you in the game long enough", "words": [[55.06, 55.34, " It"], [55.34, 55.62, " keeps"], [55.62, 55.84, " you"], [55.84, 55.96, " in"], [55.96, 56.08, " the"], [56.08, 56.4, " game"], [56.4, 56.92, " long"], [56.92, 57.24, " enough"]]}, {"start": 57.24, "end": 58.4, "text": "to get there.", "words": [[57.24, 57.68, " to"], [57.68, 57.92, " get"], [57.92, 58.4, " there."]]}, {"start": 58.96, "end": 61.92, "text": "Next time, Ada wants a second income.", "words": [[58.96, 59.18, " Next"], [59.18, 59.64, " time,"], [60.22, 60.24, " Ada"], [60.24, 60.64, " wants"], [60.64, 60.94, " a"], [60.94, 61.36, " second"], [61.36, 61.92, " income."]]}, {"start": 62.62, "end": 63.48, "text": "Where does she start?", "words": [[62.62, 62.78, " Where"], [62.78, 62.96, " does"], [62.96, 63.12, " she"], [63.12, 63.48, " start?"]]}, {"start": 64.24, "end": 64.58, "text": "See ya.", "words": [[64.24, 64.38, " See"], [64.38, 64.58, " ya."]]}]