[{"start": 0.0, "end": 2.712, "text": "Are we closer to the next financial collapse than anyone wants to admit?", "words": [[0.0, 0.136, " Are"], [0.136, 0.254, " we"], [0.254, 0.441, " closer"], [0.441, 0.644, " to"], [0.644, 0.763, " the"], [0.763, 0.949, " next"], [0.949, 1.339, " financial"], [1.339, 1.644, " collapse"], [1.644, 1.814, " than"], [1.814, 2.017, " anyone"], [2.017, 2.322, " wants"], [2.322, 2.458, " to"], [2.458, 2.712, " admit?"]]}, {"start": 3.136, "end": 7.576, "text": "Before 2000, 2008, and 2020, the same warning lights came on first.", "words": [[3.136, 3.356, " Before"], [3.356, 3.881, " 2000,"], [4.169, 4.831, " 2008,"], [5.085, 5.119, " and"], [5.119, 5.61, " 2020,"], [6.102, 6.186, " the"], [6.186, 6.424, " same"], [6.424, 6.695, " warning"], [6.695, 6.898, " lights"], [6.898, 7.102, " came"], [7.102, 7.271, " on"], [7.271, 7.576, " first."]]}, {"start": 8.0, "end": 11.898, "text": "I checked everyone against today, five are on, and there's one date nobody's watching,", "words": [[8.0, 8.068, " I"], [8.068, 8.271, " checked"], [8.271, 8.644, " everyone"], [8.644, 8.966, " against"], [8.966, 9.254, " today,"], [9.627, 9.814, " five"], [9.814, 9.966, " are"], [9.966, 10.203, " on,"], [10.441, 10.559, " and"], [10.559, 10.729, " there's"], [10.729, 10.932, " one"], [10.932, 11.136, " date"], [11.136, 11.542, " nobody's"], [11.542, 11.898, " watching,"]]}, {"start": 12.356, "end": 12.678, "text": "light one.", "words": [[12.356, 12.39, " light"], [12.39, 12.678, " one."]]}, {"start": 13.085, "end": 15.881, "text": "In 2000, the 10 biggest companies were a quarter of the market.", "words": [[13.085, 13.237, " In"], [13.237, 13.644, " 2000,"], [13.932, 14.068, " the"], [14.068, 14.237, " 10"], [14.237, 14.525, " biggest"], [14.525, 14.847, " companies"], [14.847, 15.051, " were"], [15.051, 15.237, " a"], [15.237, 15.356, " quarter"], [15.356, 15.542, " of"], [15.542, 15.627, " the"], [15.627, 15.881, " market."]]}, {"start": 16.271, "end": 17.593, "text": "Today they're 40%.", "words": [[16.271, 16.492, " Today"], [16.492, 16.881, " they're"], [16.881, 17.593, " 40%."]]}, {"start": 17.593, "end": 18.237, "text": "Light two.", "words": [[17.593, 17.949, " Light"], [17.949, 18.237, " two."]]}, {"start": 18.627, "end": 19.119, "text": "Borrowed money.", "words": [[18.627, 18.932, " Borrowed"], [18.932, 19.119, " money."]]}, {"start": 19.559, "end": 22.932, "text": "Traders owe nearly a record one and a half trillion dollars, and it's starting to roll", "words": [[19.559, 19.763, " Traders"], [19.763, 19.932, " owe"], [19.932, 20.203, " nearly"], [20.203, 20.373, " a"], [20.373, 20.627, " record"], [20.627, 20.881, " one"], [20.881, 20.983, " and"], [20.983, 21.068, " a"], [21.068, 21.237, " half"], [21.237, 21.542, " trillion"], [21.542, 21.966, " dollars,"], [22.085, 22.237, " and"], [22.237, 22.407, " it's"], [22.407, 22.593, " starting"], [22.593, 22.78, " to"], [22.78, 22.932, " roll"]]}, {"start": 22.932, "end": 25.373, "text": "over, just like before 2000 and 2007.", "words": [[22.932, 23.186, " over,"], [23.492, 23.593, " just"], [23.593, 23.78, " like"], [23.78, 24.051, " before"], [24.051, 24.508, " 2000"], [24.508, 24.712, " and"], [24.712, 25.373, " 2007."]]}, {"start": 25.864, "end": 26.237, "text": "Light three.", "words": [[25.864, 25.932, " Light"], [25.932, 26.237, " three."]]}, {"start": 26.729, "end": 28.305, "text": "The riskiest company's debt is cracking.", "words": [[26.729, 26.797, " The"], [26.797, 27.237, " riskiest"], [27.237, 27.644, " company's"], [27.644, 27.763, " debt"], [27.763, 27.966, " is"], [27.966, 28.305, " cracking."]]}, {"start": 28.797, "end": 33.339, "text": "That gap has only been this wide in 2000, 2008, 2016, and 2020.", "words": [[28.797, 28.966, " That"], [28.966, 29.153, " gap"], [29.153, 29.288, " has"], [29.288, 29.508, " only"], [29.508, 29.678, " been"], [29.678, 29.847, " this"], [29.847, 30.102, " wide"], [30.102, 30.254, " in"], [30.254, 30.644, " 2000,"], [30.949, 31.593, " 2008,"], [31.881, 32.305, " 2016,"], [32.712, 32.78, " and"], [32.78, 33.339, " 2020."]]}, {"start": 33.797, "end": 34.186, "text": "Light four.", "words": [[33.797, 33.864, " Light"], [33.864, 34.186, " four."]]}, {"start": 34.525, "end": 39.559, "text": "On November 5th, chip stocks fell 12% in one day, the Nasdaq's worst day since March 2020.", "words": [[34.525, 34.627, " On"], [34.627, 34.881, " November"], [34.881, 35.525, " 5th,"], [35.542, 35.61, " chip"], [35.61, 35.831, " stocks"], [35.831, 36.085, " fell"], [36.085, 36.441, " 12"], [36.441, 36.746, "%"], [36.746, 36.949, " in"], [36.949, 37.136, " one"], [37.136, 37.39, " day,"], [37.678, 37.763, " the"], [37.763, 38.254, " Nasdaq's"], [38.254, 38.424, " worst"], [38.424, 38.661, " day"], [38.661, 38.847, " since"], [38.847, 39.085, " March"], [39.085, 39.559, " 2020."]]}, {"start": 40.068, "end": 40.559, "text": "Light five.", "words": [[40.068, 40.186, " Light"], [40.186, 40.559, " five."]]}, {"start": 41.322, "end": 44.475, "text": "Bitcoin is 40% off its high, and the big funds are pulling money out.", "words": [[41.322, 41.322, " Bitcoin"], [41.322, 41.542, " is"], [41.542, 41.881, " 40"], [41.881, 42.169, "%"], [42.169, 42.356, " off"], [42.356, 42.508, " its"], [42.508, 42.763, " high,"], [42.915, 43.034, " and"], [43.034, 43.136, " the"], [43.136, 43.288, " big"], [43.288, 43.542, " funds"], [43.542, 43.729, " are"], [43.729, 43.966, " pulling"], [43.966, 44.169, " money"], [44.169, 44.475, " out."]]}, {"start": 44.831, "end": 48.288, "text": "Then Democrats took both houses of Congress, and the market started pricing a threat to", "words": [[44.831, 45.0, " Then"], [45.0, 45.339, " Democrats"], [45.339, 45.559, " took"], [45.559, 45.797, " both"], [45.797, 46.017, " houses"], [46.017, 46.22, " of"], [46.22, 46.492, " Congress,"], [46.678, 46.864, " and"], [46.864, 46.966, " the"], [46.966, 47.153, " market"], [47.153, 47.441, " started"], [47.441, 47.746, " pricing"], [47.746, 47.932, " a"], [47.932, 48.119, " threat"], [48.119, 48.288, " to"]]}, {"start": 48.288, "end": 48.864, "text": "the AI boom.", "words": [[48.288, 48.356, " the"], [48.356, 48.61, " AI"], [48.61, 48.864, " boom."]]}, {"start": 49.356, "end": 50.119, "text": "But here's what's missing.", "words": [[49.356, 49.424, " But"], [49.424, 49.695, " here's"], [49.695, 49.847, " what's"], [49.847, 50.119, " missing."]]}, {"start": 50.627, "end": 53.508, "text": "In every past crash, jobs broke, and a big lender failed.", "words": [[50.627, 50.678, " In"], [50.678, 50.932, " every"], [50.932, 51.203, " past"], [51.203, 51.593, " crash,"], [51.898, 52.068, " jobs"], [52.068, 52.339, " broke,"], [52.627, 52.678, " and"], [52.678, 52.763, " a"], [52.763, 52.949, " big"], [52.949, 53.203, " lender"], [53.203, 53.508, " failed."]]}, {"start": 53.966, "end": 55.034, "text": "Neither has happened, yet.", "words": [[53.966, 54.051, " Neither"], [54.051, 54.271, " has"], [54.271, 54.627, " happened,"], [54.814, 55.034, " yet."]]}, {"start": 55.559, "end": 58.305, "text": "My view, this looks more like 2000 than 2008.", "words": [[55.559, 55.712, " My"], [55.712, 55.932, " view,"], [56.271, 56.458, " this"], [56.458, 56.661, " looks"], [56.661, 56.847, " more"], [56.847, 57.0, " like"], [57.0, 57.424, " 2000"], [57.424, 57.695, " than"], [57.695, 58.305, " 2008."]]}, {"start": 58.712, "end": 62.068, "text": "And watch November 30th, when Trump Media's billion-dollar debt can come due.", "words": [[58.712, 58.864, " And"], [58.864, 59.119, " watch"], [59.119, 59.373, " November"], [59.373, 60.085, " 30th,"], [60.102, 60.186, " when"], [60.186, 60.407, " Trump"], [60.407, 60.78, " Media's"], [60.78, 61.017, " billion"], [61.017, 61.356, "-dollar"], [61.356, 61.525, " debt"], [61.525, 61.678, " can"], [61.678, 61.847, " come"], [61.847, 62.068, " due."]]}, {"start": 62.576, "end": 64.644, "text": "Comment signals, and I'll send you my crash watch list.", "words": [[62.576, 62.78, " Com